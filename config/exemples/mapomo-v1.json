    {
      "id": "services",
      "label": {
        "fr": "Services",
        "en": "Services"
      },
      "aide": {
        "fr": "Sécurité, hôtesses, photographes",
        "en": "Security, hosts, photographers"
      },
      "entree": "comptable",
      "calculs": {
        "total_services": "sum(securite, hotesses, photographes)",
        "agents_estimes": "longueur_cordon / espacement"
      },
      "noeuds": {
        "comptable": {
          "type": "choix",
          "question": {
            "fr": "Pouvez-vous compter les agents ?",
            "en": "Can you count the staff?"
          },
          "aide": {
            "fr": "Sécurité, hôtesses, photographes.",
            "en": "Security, hosts, photographers."
          },
          "options": [
            {
              "v": "oui",
              "label": {
                "fr": "Oui",
                "en": "Yes"
              },
              "sous": {
                "fr": "ils sont peu nombreux ou regroupés",
                "en": "few or grouped"
              },
              "suite": "par_metier"
            },
            {
              "v": "non",
              "label": {
                "fr": "Non",
                "en": "No"
              },
              "sous": {
                "fr": "un cordon trop long pour compter",
                "en": "a cordon too long to count"
              },
              "suite": "cordon"
            }
          ]
        },
        "par_metier": {
          "type": "compteurs",
          "question": {
            "fr": "Un nombre par métier.",
            "en": "One number per role."
          },
          "aide": {
            "fr": "Comptage exact : c'est produisible.",
            "en": "Exact count: it can be produced."
          },
          "champs": [
            {
              "id": "securite",
              "label": {
                "fr": "Sécurité",
                "en": "Security"
              }
            },
            {
              "id": "hotesses",
              "label": {
                "fr": "Hôtesses",
                "en": "Hosts"
              }
            },
            {
              "id": "photographes",
              "label": {
                "fr": "Photographes",
                "en": "Photographers"
              }
            }
          ],
          "valide": "total_services > 0",
          "apercu": {
            "fr": "{total_services} personnes",
            "en": "{total_services} people"
          },
          "affichage": {
            "fr": "{securite} sécurité · {hotesses} hôtesses · {photographes} photographes",
            "en": "{securite} security · {hotesses} hosts · {photographes} photographers"
          },
          "suite": "confiance",
          "methode": "comptage",
          "quantite": {
            "forme": "exacte",
            "valeur": "total_services"
          }
        },
        "cordon": {
          "type": "formulaire",
          "question": {
            "fr": "Distance entre agents et longueur couverte.",
            "en": "Spacing between agents and length covered."
          },
          "aide": {
            "fr": "Estimation structurée pour les cordons de sécurité.",
            "en": "Structured estimate for security cordons."
          },
          "champs": [
            {
              "id": "espacement",
              "type": "segment",
              "label": {
                "fr": "Un agent tous les",
                "en": "One agent every"
              },
              "options": [
                {
                  "v": 2,
                  "label": "2 m"
                },
                {
                  "v": 5,
                  "label": "5 m"
                },
                {
                  "v": 10,
                  "label": "10 m"
                }
              ]
            },
            {
              "id": "longueur_cordon",
              "type": "segment",
              "label": {
                "fr": "Sur une longueur de",
                "en": "Over a length of"
              },
              "options": [
                {
                  "v": 20,
                  "label": "20 m"
                },
                {
                  "v": 50,
                  "label": "50 m"
                },
                {
                  "v": 100,
                  "label": "100 m"
                },
                {
                  "v": 200,
                  "label": "200 m"
                }
              ]
            }
          ],
          "apercu": {
            "fr": "≈ {agents_estimes} agents de sécurité",
            "en": "≈ {agents_estimes} security agents"
          },
          "affichage": {
            "fr": "≈ {agents_estimes} agents de sécurité (cordon)",
            "en": "≈ {agents_estimes} security agents (cordon)"
          },
          "suite": "confiance",
          "methode": "structure"
        }
      },
      "fourniture": true
    },
